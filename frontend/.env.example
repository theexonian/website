# Server-only. Never add this to the `env` block of next.config.js: that inlines
# the value into client bundles. Rotate in Strapi admin > Settings > API Tokens.
STRAPI_API=

# Server-only. Set to "true" to disable the members-only gate during local work.
# Has no effect on Vercel. See docs/apis.md.
BYPASS_AUTH=false

# Public by design: inlined into the browser bundle because /search runs
# client-side. Use a search-only key here, never a master/admin key.
NEXT_PUBLIC_MEILISEARCH_URL=https://meilisearch.theexonian.net
NEXT_PUBLIC_MEILISEARCH_PK=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_c2V0dGxpbmctc3RpbmdyYXktOTYuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=

# Custom Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Server-only; read by src/app/api/speechify/route.ts.
SPEECHIFY_API_KEY=

LISTMONK_API_URL=http://34.233.229.132:9000/api/subscribers
LISTMONK_APITOKEN=
